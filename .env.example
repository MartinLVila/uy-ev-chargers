# Neon Postgres connection string.
# Pooled endpoint for the app, direct endpoint for migrations both work.
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# Shared secret for POST /api/poll. Any scheduler that triggers a poll must send
# it as "Authorization: Bearer <value>". Vercel Cron sends this header itself.
CRON_SECRET="generate-with-openssl-rand-hex-32"

# Upstash Redis, used only for rate limiting. Provisioned through the Vercel Marketplace,
# which sets these automatically on deployments. Without them the API still answers, but
# unthrottled, and the app logs that rate limiting is disabled.
KV_REST_API_URL="https://example.upstash.io"
KV_REST_API_TOKEN="generated-by-the-upstash-integration"
